#!/bin/sh /etc/rc.common
# shellcheck shell=busybox

START=95
STOP=10
USE_PROCD=1

CONFIG_FILE="/etc/config/vpn-sticky"
NFT_TEMPLATE="/usr/share/vpn-sticky/vpn-sticky.nft.uc"
RUNTIME_NFT="/tmp/vpn-sticky.nft"
# Kernel objects (rules/routes) installed by the last apply, one per line:
#   rule <family> <pref>
#   route <family> <table> <prefix>
# Lets a reload update in place and remove only what is no longer wanted,
# instead of flushing everything first (which opened a no-route window).
STATE_FILE="/var/run/vpn-sticky.state"
LOCK_FILE="/var/lock/vpn-sticky.lock"

. /lib/functions.sh

VS_ENABLED=1
VS_IPV6=1
VS_MARK_MASK="0x70000000"
VS_PREFIXES=""
VS_IFACES=""
VS_DEBUG=0
VS_STATE=""

vlog() {
	[ "$VS_DEBUG" = "1" ] || return 0
	logger -p daemon.info -t vpn-sticky "$*"
}

# Normalize a mark to the form `ip rule show` prints (lowercase hex).
norm_mark() {
	printf "0x%x" "$1" 2>/dev/null
}

collect_prefix() {
	local prefix="$1"
	[ -n "$prefix" ] || return 0
	VS_PREFIXES="${VS_PREFIXES} ${prefix}"
}

collect_iface() {
	local section="$1"
	local name mark rule_pref route_table

	config_get name "$section" name
	config_get mark "$section" mark
	config_get rule_pref "$section" rule_pref
	config_get route_table "$section" route_table

	[ -n "$name" ] || return 0
	[ -n "$mark" ] || return 0
	[ -n "$rule_pref" ] || return 0
	[ -n "$route_table" ] || return 0

	mark="$(norm_mark "$mark")" || {
		logger -p daemon.err -t vpn-sticky "iface $name: invalid mark, skipping"
		return 0
	}

	VS_IFACES="${VS_IFACES} ${name}|${mark}|${rule_pref}|${route_table}"
}

load_config_data() {
	VS_ENABLED=1
	VS_IPV6=1
	VS_MARK_MASK="0x70000000"
	VS_PREFIXES=""
	VS_IFACES=""
	VS_DEBUG=0

	config_load vpn-sticky || return 1
	config_get_bool VS_ENABLED daemon enabled 1
	config_get_bool VS_IPV6 daemon ipv6 1
	config_get VS_MARK_MASK daemon mark_mask "0x70000000"
	config_get_bool VS_DEBUG daemon debug 0
	config_list_foreach daemon target_prefix collect_prefix
	config_foreach collect_iface iface

	VS_MARK_MASK="$(norm_mark "$VS_MARK_MASK")" || return 1

	vlog "config: enabled=$VS_ENABLED ipv6=$VS_IPV6 mark_mask=$VS_MARK_MASK prefixes='$VS_PREFIXES'"
}

iface_netifd_up() {
	# Authoritative readiness: netifd reports the interface as up (addresses
	# applied, device present). A down iface is skipped, not waited for: the
	# next interface.update trigger brings its routes in.
	ubus call "network.interface.$1" status 2>/dev/null | grep -q '"up": *true'
}

# Prefixes routed into the sticky table for a family. Without target_prefix
# the table holds a default route: a marked packet is always a reply to a host
# that reached us through that tunnel, so the tunnel is the way back.
family_prefixes() {
	local fam="$1"
	local prefix out=""

	[ -n "$VS_PREFIXES" ] || { echo default; return; }

	for prefix in $VS_PREFIXES; do
		case "$prefix" in
		default) out="$out $prefix" ;;
		*:*) [ "$fam" = 6 ] && out="$out $prefix" ;;
		*) [ "$fam" = 4 ] && out="$out $prefix" ;;
		esac
	done
	echo "${out# }"
}

state_add() {
	VS_STATE="${VS_STATE}$*
"
}

ensure_rule() {
	local fam="$1" pref="$2" mark="$3" table="$4"
	local want="fwmark $mark/$VS_MARK_MASK lookup $table"

	state_add rule "$fam" "$pref"

	# Already correct: leave it alone, a del/add would drop packets.
	[ "$(ip -"$fam" rule show pref "$pref" 2>/dev/null)" = "$pref:	from all $want" ] && return 0

	while ip -"$fam" rule del pref "$pref" 2>/dev/null; do :; done
	# shellcheck disable=SC2086
	ip -"$fam" rule add pref "$pref" $want \
		|| logger -p daemon.err -t vpn-sticky "rule add failed: -$fam pref $pref $want"
}

apply_iface() {
	local name="$1" mark="$2" rule_pref="$3" route_table="$4"
	local fam prefix up=0

	iface_netifd_up "$name" && up=1
	[ "$up" = 1 ] || logger -p daemon.notice -t vpn-sticky "iface $name not up, routes skipped"

	for fam in 4 6; do
		[ "$fam" = 6 ] && [ "$VS_IPV6" != 1 ] && continue

		ensure_rule "$fam" "$rule_pref" "$mark" "$route_table"

		[ "$up" = 1 ] || continue
		for prefix in $(family_prefixes "$fam"); do
			state_add route "$fam" "$route_table" "$prefix"
			ip -"$fam" route replace table "$route_table" "$prefix" dev "$name" \
				|| logger -p daemon.err -t vpn-sticky "route add failed: -$fam $prefix dev $name table $route_table"
		done
	done

	vlog "applied $name (table $route_table, mark $mark, up=$up)"
}

remove_state_entry() {
	local kind="$1" fam="$2"

	case "$kind" in
	rule)
		while ip -"$fam" rule del pref "$3" 2>/dev/null; do :; done
		;;
	route)
		ip -"$fam" route del table "$3" "$4" 2>/dev/null
		;;
	esac
	vlog "removed stale $*"
}

# Remove every state line from $1 (file) that is not in $2 (file, may be empty).
remove_stale() {
	local old="$1" new="$2" line

	[ -f "$old" ] || return 0
	# not grep -vxFf: busybox grep matches every line with an empty pattern file
	awk -v newf="$new" 'BEGIN { while ((getline l < newf) > 0) want[l] = 1 } !($0 in want)' "$old" |
	while read -r line; do
		# shellcheck disable=SC2086
		[ -n "$line" ] && remove_state_entry $line
	done
}

# Pre-state-file installs flushed+re-added everything; on the first apply
# without a state file, clear what the configured ifaces may have left behind.
flush_legacy() {
	local entry name mark rule_pref route_table fam oldifs

	for entry in $VS_IFACES; do
		oldifs="$IFS"; IFS='|'
		# shellcheck disable=SC2086
		set -- $entry
		IFS="$oldifs"
		rule_pref="$3" route_table="$4"
		for fam in 4 6; do
			while ip -"$fam" rule del pref "$rule_pref" 2>/dev/null; do :; done
			ip -"$fam" route flush table "$route_table" 2>/dev/null
		done
	done
}

apply_routes() {
	local entry oldifs tmp

	VS_STATE=""
	[ -f "$STATE_FILE" ] || flush_legacy

	if [ "$VS_ENABLED" = "1" ]; then
		for entry in $VS_IFACES; do
			oldifs="$IFS"; IFS='|'
			# shellcheck disable=SC2086
			set -- $entry
			IFS="$oldifs"
			apply_iface "$1" "$2" "$3" "$4"
		done
	fi

	tmp="${STATE_FILE}.new"
	printf "%s" "$VS_STATE" >"$tmp"
	remove_stale "$STATE_FILE" "$tmp"
	mv "$tmp" "$STATE_FILE"
}

remove_routes() {
	local empty="${STATE_FILE}.empty"

	: >"$empty"
	remove_stale "$STATE_FILE" "$empty"
	rm -f "$empty" "$STATE_FILE"
}

apply_nft_rules() {
	local tmpfile

	command -v nft >/dev/null 2>&1 || return 0

	if [ "$VS_ENABLED" != "1" ]; then
		disable_nft_rules
		return 0
	fi

	command -v utpl >/dev/null 2>&1 || return 0
	[ -r "$NFT_TEMPLATE" ] || return 1

	tmpfile="$(mktemp -p /tmp vpn-sticky.nft.XXXXXX)" || return 1

	if ! utpl -S "$NFT_TEMPLATE" >"$tmpfile"; then
		logger -p daemon.err -t vpn-sticky "failed to render $NFT_TEMPLATE"
		rm -f "$tmpfile"
		return 1
	fi

	mv "$tmpfile" "$RUNTIME_NFT"

	# The rendered file deletes and re-creates the table in one transaction:
	# on failure the old ruleset stays in place.
	if ! nft -f "$RUNTIME_NFT"; then
		logger -p daemon.err -t vpn-sticky "failed to apply nft rules"
		return 1
	fi
}

disable_nft_rules() {
	command -v nft >/dev/null 2>&1 || return 0
	nft delete table inet vpn_sticky >/dev/null 2>&1 || true
}

start_service() {
	reload_service
}

reload_service() {
	local ret=0

	[ -f "$CONFIG_FILE" ] || return 0

	# procd triggers and manual reloads may overlap
	lock "$LOCK_FILE"
	vlog "reload_service called"

	if load_config_data; then
		apply_nft_rules || ret=1
		apply_routes
	else
		ret=1
	fi

	lock -u "$LOCK_FILE"
	return $ret
}

stop_service() {
	lock "$LOCK_FILE"
	disable_nft_rules
	if [ -f "$STATE_FILE" ]; then
		remove_routes
	elif [ -f "$CONFIG_FILE" ] && load_config_data; then
		flush_legacy
	fi
	lock -u "$LOCK_FILE"
}

add_iface_trigger() {
	local section="$1"
	local name

	config_get name "$section" name
	[ -n "$name" ] || return 0

	vlog "registering netifd trigger for iface $name"
	# netifd emits interface.update on bring-up and interface.down on teardown.
	# Only react to bring-up: on teardown the kernel drops the dev routes
	# itself and the rule then just falls through to the main table.
	procd_add_interface_trigger "interface.update" "$name" /etc/init.d/vpn-sticky reload
}

service_triggers() {
	config_get_bool VS_DEBUG daemon debug 0
	vlog "registering triggers"
	procd_add_reload_trigger "vpn-sticky"

	[ -f "$CONFIG_FILE" ] || return 0
	config_load vpn-sticky || return 0
	config_foreach add_iface_trigger iface
}
