#!/bin/sh /etc/rc.common
# shellcheck shell=busybox

START=95
STOP=10
USE_PROCD=1

CONFIG_FILE="/etc/config/vpn-sticky"
NFT_TEMPLATE="/usr/share/vpn-sticky/vpn-sticky.nft.uc"
RUNTIME_NFT="/tmp/vpn-sticky.nft"

. /lib/functions.sh

VS_ENABLED=1
VS_MARK_MASK="0x70000000"
VS_PREFIXES=""
VS_IFACES=""
VS_DEBUG=0
VS_APPLY_RETRIES=5
VS_APPLY_DELAY=1

vlog() {
	[ "$VS_DEBUG" = "1" ] || return 0
	logger -p daemon.info -t vpn-sticky "$*"
}

collect_prefix() {
	local prefix="$1"
	[ -n "$prefix" ] || return 0
	VS_PREFIXES="${VS_PREFIXES} ${prefix}"
}

collect_iface() {
	local section="$1"
	local name mark rule_pref route_table

	config_get name "$section" name
	config_get mark "$section" mark
	config_get rule_pref "$section" rule_pref
	config_get route_table "$section" route_table

	[ -n "$name" ] || return 0
	[ -n "$mark" ] || return 0
	[ -n "$rule_pref" ] || return 0
	[ -n "$route_table" ] || return 0

	VS_IFACES="${VS_IFACES}${name}|${mark}|${rule_pref}|${route_table}
"
}

load_config_data() {
	VS_ENABLED=1
	VS_MARK_MASK="0x70000000"
	VS_PREFIXES=""
	VS_IFACES=""
	VS_DEBUG=0

	config_load vpn-sticky || return 1
	config_get_bool VS_ENABLED daemon enabled 1
	config_get VS_MARK_MASK daemon mark_mask "0x70000000"
	config_get_bool VS_DEBUG daemon debug 0
	config_list_foreach daemon target_prefix collect_prefix
	config_foreach collect_iface iface

	vlog "config: enabled=$VS_ENABLED mark_mask=$VS_MARK_MASK prefixes='$VS_PREFIXES'"
}

flush_routes() {
	local name mark rule_pref route_table

	printf "%s" "$VS_IFACES" | while IFS='|' read -r name mark rule_pref route_table; do
		[ -n "$name" ] || continue
		ip -4 rule del pref "$rule_pref" 2>/dev/null || true
		ip -4 route flush table "$route_table" 2>/dev/null || true
		vlog "flushed routes for $name (table $route_table)"
	done
}

apply_routes() {
	local name mark rule_pref route_table prefix
	local attempt link_up

	printf "%s" "$VS_IFACES" | while IFS='|' read -r name mark rule_pref route_table; do
		[ -n "$name" ] || continue

		attempt=0
		link_up=0
		while [ "$attempt" -lt "$VS_APPLY_RETRIES" ]; do
			if ip link show dev "$name" >/dev/null 2>&1; then
				link_up=1
				break
			fi
			attempt=$((attempt + 1))
			vlog "iface $name not up, retry $attempt/$VS_APPLY_RETRIES"
			sleep "$VS_APPLY_DELAY"
		done

		if [ "$link_up" -ne 1 ]; then
			logger -p daemon.warn -t vpn-sticky "iface $name not available after $VS_APPLY_RETRIES retries, skipping routes/rule"
			continue
		fi

		for prefix in $VS_PREFIXES; do
			ip -4 route replace table "$route_table" "$prefix" dev "$name" \
				|| logger -p daemon.err -t vpn-sticky "route add failed: $prefix dev $name table $route_table"
		done

		ip -4 rule del pref "$rule_pref" 2>/dev/null || true
		ip -4 rule add pref "$rule_pref" fwmark "$mark/$VS_MARK_MASK" lookup "$route_table" \
			|| logger -p daemon.err -t vpn-sticky "rule add failed: pref $rule_pref mark $mark table $route_table"

		vlog "applied routes for $name (table $route_table, mark $mark)"
	done
}

apply_nft_rules() {
	local tmpfile

	command -v nft >/dev/null 2>&1 || return 0
	command -v utpl >/dev/null 2>&1 || return 0
	[ -r "$NFT_TEMPLATE" ] || return 1

	nft delete table inet vpn_sticky >/dev/null 2>&1 || true

	[ "$VS_ENABLED" = "1" ] || return 0

	tmpfile="$(mktemp -p /tmp vpn-sticky.nft.XXXXXX)" || return 1

	if ! utpl -S "$NFT_TEMPLATE" >"$tmpfile"; then
		logger -p daemon.err -t vpn-sticky "failed to render $NFT_TEMPLATE"
		rm -f "$tmpfile"
		return 1
	fi

	mv "$tmpfile" "$RUNTIME_NFT"

	if ! nft -f "$RUNTIME_NFT"; then
		logger -p daemon.err -t vpn-sticky "failed to apply nft rules"
		return 1
	fi
}

disable_nft_rules() {
	command -v nft >/dev/null 2>&1 || return 0
	nft delete table inet vpn_sticky >/dev/null 2>&1 || true
}

start_service() {
	reload_service
}

reload_routes() {
	[ -f "$CONFIG_FILE" ] || return 0
	load_config_data || return 1

	vlog "reload triggered (enabled=$VS_ENABLED)"
	flush_routes
	[ "$VS_ENABLED" = "1" ] && apply_routes
}

reload_service() {
	logger -p daemon.info -t vpn-sticky "reload_service called"
	reload_routes || return 1
	apply_nft_rules
}

stop_service() {
	if [ -f "$CONFIG_FILE" ]; then
		load_config_data || return 1
		flush_routes
	fi

	disable_nft_rules
}

add_iface_trigger() {
	local section="$1"
	local name

	config_get name "$section" name
	[ -n "$name" ] || return 0

	vlog "registering netifd trigger for iface $name"
	procd_add_interface_trigger "interface.*" "$name" /etc/init.d/vpn-sticky reload
}

service_triggers() {
	config_get_bool VS_DEBUG daemon debug 0
	vlog "registering triggers"
	procd_add_reload_trigger "vpn-sticky"
	procd_add_interface_trigger "interface.*" "lan" /etc/init.d/vpn-sticky reload

	[ -f "$CONFIG_FILE" ] || return 0
	config_load vpn-sticky || return 0
	config_foreach add_iface_trigger iface
}
