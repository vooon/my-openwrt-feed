#!/bin/sh /etc/rc.common

# shellcheck shell=dash
# procd init script for meow-rs.
# Service settings live in /etc/config/meow-rs (UCI); the proxy configuration
# itself is the regular meow YAML file (default /etc/meow-rs/config.yaml).

USE_PROCD=1
START=99

PROG=/usr/bin/meow-rs
CONF=meow-rs

list_append_args() {
	procd_append_param command "$1"
}

start_instance() {
	local enabled user config workdir jail

	config_get_bool enabled "$1" enabled 0
	[ "$enabled" -ne 0 ] || return 0

	config_get config "$1" config_file "/etc/meow-rs/config.yaml"
	config_get workdir "$1" work_dir "/var/lib/meow-rs"
	config_get_bool jail "$1" jail 1
	config_get user "$1" user "meow"

	local group="$(id -ng $user)"
	mkdir -p "$workdir"
	chown "$user:$group" "$workdir"

	procd_open_instance "$1"

	procd_set_param command "$PROG" -d "$workdir" -f "$config"
	config_list_foreach "$1" extra_arg list_append_args

	# Use root user if you want to use the TUN mode or tproxy firewall.
	procd_set_param user "$user"
	procd_set_param file "$config"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"

	if [ "$jail" -ne 0 ]; then
		procd_add_jail meow-rs log
		procd_add_jail_mount "$config"
		procd_add_jail_mount_rw "$workdir"
		# BoringSSL CA store + system DNS for proxy-server resolution.
		procd_add_jail_mount "/etc/ssl/certs"
		procd_add_jail_mount "/etc/resolv.conf"
		config_list_foreach "$1" ro_mount procd_add_jail_mount
		config_list_foreach "$1" rw_mount procd_add_jail_mount_rw
		[ -x /sbin/ujail -a -e /etc/capabilities/meow-rs.json ] && \
			procd_set_param capabilities /etc/capabilities/meow-rs.json
	fi

	procd_close_instance
}

start_service() {
	config_load "$CONF"
	config_foreach start_instance instance
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}