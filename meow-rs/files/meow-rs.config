config instance 'main'
	option enabled '0'
	option config_file '/etc/meow-rs/config.yaml'
	option work_dir '/var/lib/meow-rs'
	# Port of the REST API / built-in web panel. Informational for LuCI:
	# it must match the `external-controller` port in config.yaml.
	option panel_port '9090'
	# Run under ujail (defaults to 1). Disable for TUN/tproxy firewall
	# access; also needs user 'root' then.
	# option jail '1'
	# option user 'meow'
	# list ro_mount '/etc/ssl/certs'
	# list ro_mount '/etc/localtime'
	# list rw_mount '/var/log/meow-rs'
	# list extra_arg '-v'