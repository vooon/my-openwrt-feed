ngx_addon_name=ngx_http_ucode_module

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_ucode_module
    ngx_module_srcs="$ngx_addon_dir/ngx_http_ucode_module.c \
                     $ngx_addon_dir/http_parse.c \
                     $ngx_addon_dir/vendor/multipart-parser-c/multipart_parser.c"
    ngx_module_incs="$ngx_addon_dir"
    ngx_module_libs="-lucode -ljson-c"

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_ucode_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_http_ucode_module.c \
                   $ngx_addon_dir/http_parse.c \
                   $ngx_addon_dir/vendor/multipart-parser-c/multipart_parser.c"
    CORE_INCS="$CORE_INCS $ngx_addon_dir"
    CORE_LIBS="$CORE_LIBS -lucode -ljson-c"
fi