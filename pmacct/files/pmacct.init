#!/bin/sh /etc/rc.common

START=80
STOP=89
USE_PROCD=1

PROG=/usr/sbin/pmacctd
CONF=pmacct
CONF_DIR=/var/etc/pmacct
CONF_FILE="$CONF_DIR/pmacctd.conf"
MAP_FILE="$CONF_DIR/pcap_interfaces.map"

TAB="	"

pmacct_iface() {
	local ifname ifindex direction line

	config_get ifname "$1" ifname
	config_get direction "$1" direction
	config_get ifindex "$1" ifindex

	[ -n "$ifname" ] || return 0

	[ -n "$ifindex" ] || ifindex="$((n + 1))"

	line="ifindex=$ifindex"
	line="$line${TAB}ifname=$ifname"
	[ -n "$direction" ] && line="$line${TAB}direction=$direction"
	echo "$line" >> "$MAP_FILE"

	n=$((n + 1))
}

write_listen_config() {
	local plisten

	# count explicit interface sections first
	config_foreach pmacct_iface interface

	if [ "$n" -gt 0 ]; then
		echo "pcap_ifindex: map" >> "$CONF_FILE"
		echo "pcap_interfaces_map: $MAP_FILE" >> "$CONF_FILE"
		return 0
	fi

	# no interfaces defined: listen on a single device
	config_get plisten service plisten any
	echo "pcap_interface: $plisten" >> "$CONF_FILE"
}

start_service() {
	local enabled protocol collector sampling agent_ip agent_subid
	local snaplen promisc debug logfile nfprobe_version aggregate

	config_load "$CONF"
	config_get_bool enabled service enabled 0
	[ "$enabled" -ne 0 ] || return

	config_get protocol        service protocol  ipfix
	config_get collector       service collector ""
	config_get sampling        service sampling_rate 0
	config_get snaplen         service snaplen 686
	config_get agent_ip        service agent_ip ""
	config_get agent_subid     service agent_subid 1402
	config_get nfprobe_version service nfprobe_version 10
	config_get_bool promisc    service promisc 0
	config_get_bool debug      service debug 0
	config_get logfile         service logfile ""
	config_get aggregate       service aggregate ""

	mkdir -p "$CONF_DIR"
	: > "$CONF_FILE"
	: > "$MAP_FILE"

	echo "daemonize: false" > "$CONF_FILE"
	[ "$debug" -gt 0 ] && echo "debug: true" >> "$CONF_FILE"
	[ -n "$logfile" ] && echo "logfile: $logfile" >> "$CONF_FILE"
	echo "snaplen: $snaplen" >> "$CONF_FILE"
	[ "$promisc" -gt 0 ] && echo "promisc: true" >> "$CONF_FILE"
	[ "$sampling" -gt 0 ] && echo "sampling_rate: $sampling" >> "$CONF_FILE"
	[ -n "$aggregate" ] && echo "aggregate: $aggregate" >> "$CONF_FILE"

	case "$protocol" in
		sflow)
			echo "plugins: sfprobe" >> "$CONF_FILE"
			[ -n "$agent_ip" ] && echo "sfprobe_agentip: $agent_ip" >> "$CONF_FILE"
			[ -n "$agent_subid" ] && echo "sfprobe_agentsubid: $agent_subid" >> "$CONF_FILE"
			[ -n "$collector" ] && echo "sfprobe_receiver: $collector" >> "$CONF_FILE"
			;;
		netflow|ipfix)
			echo "plugins: nfprobe" >> "$CONF_FILE"
			[ -n "$nfprobe_version" ] && echo "nfprobe_version: $nfprobe_version" >> "$CONF_FILE"
			[ -n "$collector" ] && echo "nfprobe_receiver: $collector" >> "$CONF_FILE"
			;;
		*)
			logger -t pmacct "unknown protocol '$protocol'"
			return 1
			;;
	esac

	local n=0
	write_listen_config

	procd_open_instance
	procd_set_param command "$PROG" -f "$CONF_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
