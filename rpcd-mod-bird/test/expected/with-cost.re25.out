# BIRD configuration file (test fixture: some interfaces carry costs)
# Sanitized doc-range addresses / generic names.

router id 192.0.2.1;
hostname "test-node";

protocol device {
}

protocol ospf v3 mesh_v3 {
	ipv6 {
		import all;
		export none;
	};
	area 0 {
		interface "awg0" {
			cost 40;
			type ptp;
			hello 2;
			dead count 4;
		};
		interface "awg1" {
			type ptp;
			hello 2;
			cost 25;
			dead count 4;
		};
		interface "dummy0" {
			stub;
		};
	};
}