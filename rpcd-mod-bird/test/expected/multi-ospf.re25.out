# BIRD configuration file (test fixture: two OSPF protocols)
# mesh_v3 carries the mesh links (awg_*), pve_v2 is an unrelated
# underlay instance (eth2/eth3).  Sanitized doc-range addresses / names.

router id 192.0.2.1;
hostname "test-node";

protocol device {
}

protocol ospf v3 pve_v2 {
	ipv6 {
		import all;
		export none;
	};
	area 0 {
		interface "eth2" {
			cost 66;
			type broadcast;
			hello 10;
		};
		interface "eth3" {
			type broadcast;
			hello 10;
		};
	};
}

protocol ospf v3 mesh_v3 {
	ipv6 {
		import all;
		export none;
	};
	area 0 {
		interface "awg0" {
			type ptp;
		};
		interface "awg1" {
			cost 25;
			type ptp;
		};
		interface "dummy0" {
			stub;
		};
	};
}